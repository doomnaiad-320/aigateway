# =========================
# 基础运行配置
# =========================

# MAX-API 监听端口；Nginx 可反代到 http://127.0.0.1:3001
PORT=3001

# 服务时区，影响日志时间、任务时间等
TZ=Asia/Shanghai

# 调试模式；生产环境建议 false
DEBUG=false

# 当前节点类型；单机或主节点用 master
NODE_TYPE=master

# pprof 性能分析开关；生产环境一般关闭
ENABLE_PPROF=false

# 是否为新用户自动生成默认 Token；生产环境建议 false
GENERATE_DEFAULT_TOKEN=false


# =========================
# 安全密钥
# =========================

# 会话密钥：用于登录会话 Cookie 加密/校验；多节点必须保持一致
# 生成示例：openssl rand -hex 32
SESSION_SECRET=replace_with_random_session_secret

# 加密/HMAC 密钥：用于缓存、签名、加密相关逻辑；启用 Redis 或多节点时必须固定且一致
# 生成示例：openssl rand -hex 32
CRYPTO_SECRET=replace_with_random_crypto_secret


# =========================
# 数据库配置
# =========================

# MySQL 连接字符串；charset/collation 保证中文和 emoji 兼容，parseTime/loc 处理时间字段
SQL_DSN=howlife:replace_with_mysql_password@tcp(127.0.0.1:3306)/howlife?charset=utf8mb4&collation=utf8mb4_unicode_ci&parseTime=true&loc=Local


# =========================
# Redis 缓存
# =========================

# Redis 地址；用于缓存、限流、多节点状态共享等
REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# Redis 连接池大小；并发高可以适当提高
REDIS_POOL_SIZE=120

# 是否启用内存缓存；建议开启，降低数据库/Redis 压力
MEMORY_CACHE_ENABLED=true

# 数据同步/缓存刷新频率，单位秒
SYNC_FREQUENCY=60


# =========================
# 请求、并发、长流式响应
# =========================

# HTTP 客户端最大空闲连接数；影响上游连接复用
RELAY_MAX_IDLE_CONNS=2000

# 每个上游 Host 最大空闲连接数；高并发同一供应商时有用
RELAY_MAX_IDLE_CONNS_PER_HOST=400

# 空闲连接保留时间，单位秒
RELAY_IDLE_CONN_TIMEOUT=90

# 上游请求总超时；0 表示不设置总超时，适合 Claude 长思考
RELAY_TIMEOUT=0

# 流式响应空闲超时，单位秒；Claude 长思考建议 1800，即 30 分钟
STREAMING_TIMEOUT=1800


# =========================
# 稳定性与安全限制
# =========================

# 是否跳过 TLS 证书校验；生产环境必须 false
TLS_INSECURE_SKIP_VERIFY=false

# 是否记录错误日志；建议开启，方便排查上游超时和 5xx
ERROR_LOG_ENABLED=true

# 是否强制流式请求带 usage 选项；支持的渠道会尽量返回用量
FORCE_STREAM_OPTION=true

# 请求体最大大小，单位 MB；超出会拒绝
MAX_REQUEST_BODY_MB=128

# 流式扫描器单行最大缓冲，单位 MB；大响应/图片/base64 场景建议 128
STREAM_SCANNER_MAX_BUFFER_MB=128

# 文件下载最大大小，单位 MB
MAX_FILE_DOWNLOAD_MB=64


# =========================
# 批量更新与异步任务
# =========================

# 是否启用批量更新；高并发下可减少数据库写入压力
BATCH_UPDATE_ENABLED=true

# 批量更新间隔，单位秒
BATCH_UPDATE_INTERVAL=5

# 是否启用异步任务轮询/更新
UPDATE_TASK=true
